# Copy to .env and replace placeholders. Never commit real secrets.

# Required in production (HS256, at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional overrides for local development
DATABASE_URL=jdbc:postgresql://localhost:5432/docmind
DATABASE_USERNAME=docmind
DATABASE_PASSWORD=docmind
EMBEDDING_BASE_URL=http://127.0.0.1:8000
UPLOAD_DIR=uploads

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
